{
  "name": "secure-document-exchange-cloud-providers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./google/auth": {
      "types": "./dist/google/auth.d.ts",
      "default": "./dist/google/auth.js"
    },
    "./google/drive-picker": {
      "types": "./dist/google/drive-picker.d.ts",
      "default": "./dist/google/drive-picker.js"
    },
    "./microsoft/auth": {
      "types": "./dist/microsoft/auth.d.ts",
      "default": "./dist/microsoft/auth.js"
    },
    "./microsoft/file-picker": {
      "types": "./dist/microsoft/file-picker.d.ts",
      "default": "./dist/microsoft/file-picker.js"
    },
    "./microsoft/redirect-bridge": {
      "types": "./dist/microsoft/redirect-bridge.d.ts",
      "default": "./dist/microsoft/redirect-bridge.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test --import tsx \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.21.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "react": "19.2.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
